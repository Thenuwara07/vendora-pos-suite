# Real MOSIP (leave MOCK false) – fill these when you get them
VITE_MOSIP_ISSUER=https://<your-issuer-domain>      # e.g. https://ida.mosip.net
VITE_MOSIP_CLIENT_ID=<your-client-id>
VITE_MOSIP_REDIRECT_URI=http://localhost:8080/auth/callback
VITE_MOSIP_SCOPE=openid profile email phone

# Toggle mock:
VITE_MOSIP_MOCK=true
